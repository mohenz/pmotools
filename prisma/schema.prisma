  assignees PmoDelayedTaskAssignee[]

  @@index([snapshotId, archivedAt])
  @@index([groupId])
  @@map("pmo_delayed_tasks")
}

model PmoDelayedTaskAssignee {
  taskId String
  userId String

  task PmoDelayedTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("pmo_delayed_task_assignees")
}

model PmoDelayedTaskSequence {
  projectId String @id
  value     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("pmo_delayed_task_sequences")
}

// ---------------------------------------------------------------------------
// 주차 / 주간보고 / 주간실적 / 인력변동
// ---------------------------------------------------------------------------

enum WeekStatus {
  open
  closed
}

enum ChangeType {
  join
  leave
}

model Week {
  id        String     @id @default(uuid())
  projectId String
  weekKey   String
  label     String
  startDate DateTime   @db.Date
  endDate   DateTime   @db.Date
  status    WeekStatus @default(open)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reports      WeeklyReport[]
  progress     WeeklyProgress[]
  staffChanges StaffChange[]
  summary      WeeklySummary?

  @@unique([projectId, weekKey])
  @@map("weeks")
}

model WeeklyReport {
  id           String   @id @default(uuid())
  weekId       String
  groupId      String
  achievements String   @default("")
  nextPlan     String   @default("")
  issues       String   @default("")
  decisions    String   @default("")
  notes        String   @default("")
  createdBy    String
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  week    Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  group   Groups @relation(fields: [groupId], references: [id])
  creator User   @relation("WeeklyReportCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([weekId, groupId])
  @@map("weekly_reports")
}

model WeeklySummary {
  id          String   @id @default(uuid())
  weekId      String   @unique
  summary     String
  sourceHash  String
  model       String
  generatedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  week      Week @relation(fields: [weekId], references: [id], onDelete: Cascade)
  generator User @relation("WeeklySummaryGenerator", fields: [generatedBy], references: [id], onDelete: Restrict)

  @@map("weekly_summaries")
}

model WeeklyProgress {
  id             String    @id @default(uuid())
  weekId         String
  groupId        String
  taskName       String
  planDetail     String    @default("")
  planTargetDate DateTime? @db.Date
  actualDetail   String    @default("")
  actualDate     DateTime? @db.Date
  progress       Int       @default(0)
  nextPlan       String    @default("")
  nextTargetDate DateTime? @db.Date
  notes          String    @default("")
  createdBy      String
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  week    Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  group   Groups @relation(fields: [groupId], references: [id])
  creator User   @relation("WeeklyProgressCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([weekId, groupId])
  @@map("weekly_progress")
}

model StaffChange {
  id           String     @id @default(uuid())
  weekId       String
  groupId      String
  changeType   ChangeType
  currentCount Int
  nextCount    Int
  notes        String     @default("")
  createdBy    String
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  week    Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  group   Groups @relation(fields: [groupId], references: [id])
  creator User   @relation("StaffChangeCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([weekId, groupId, changeType])
  @@map("staff_changes")
}

// ---------------------------------------------------------------------------
// 캘린더
// ---------------------------------------------------------------------------

enum CalendarEventType {
  meeting
  milestone
  work
  other
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum ExceptionType {
  MODIFIED
  DELETED
}

model CalendarEvent {
  id             String            @id @default(uuid())
  projectId      String
  title          String
  description    String            @default("")
  eventType      CalendarEventType @default(other)
  startAt        DateTime
  endAt          DateTime
  allDay         Boolean           @default(false)
  priority       Priority          @default(MEDIUM)
  isMilestone    Boolean           @default(false)
  groupId        String?
  location       String            @default("")
  memo           String            @default("")
  recurrenceRule String?
  createdBy      String
  updatedBy      String?
  version        Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group              Groups?           @relation(fields: [groupId], references: [id])
  creator            User              @relation("CalendarEventCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater            User?             @relation("CalendarEventUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  exceptions         EventException[]
  assignees          EventAssignee[]
  groupTags          EventGroupTag[]
  attachments        EventAttachment[]
  invitationMessages Message[]

  @@index([projectId, startAt, endAt])
  @@index([projectId, isMilestone])
  @@map("calendar_events")
}

model EventException {
  id            String        @id @default(uuid())
  eventId       String
  exceptionDate DateTime      @db.Date
  type          ExceptionType
  overrideData  Json?
  createdAt     DateTime      @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, exceptionDate])
  @@map("event_exceptions")
}

model EventAssignee {
  id        String  @id @default(uuid())
  eventId   String
  userId    String?
  guestName String?

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_assignees")
}

model EventGroupTag {
  eventId String
  groupId String

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group Groups        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([eventId, groupId])
  @@map("event_group_tags")
}

model EventAttachment {
  id          String   @id @default(uuid())
  eventId     String
  fileName    String
  storagePath String // Supabase Storage 버킷 경로
  fileSize    Int
  uploadedAt  DateTime @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_attachments")
}

// ---------------------------------------------------------------------------
// 쪽지 / 알림 설정
// ---------------------------------------------------------------------------

enum MessageType {
  DIRECT
  CALENDAR_INVITATION
  MEETING_INVITATION
}

model Message {
  id                   String      @id @default(uuid())
  senderId             String
  receiverId           String
  messageType          MessageType @default(DIRECT)
  contentEncrypted     String?
  contentIv            String?
  viewPasswordHash     String?
  calendarEventId      String?
  meetingReservationId String?
  systemPayload        Json?
  isRead               Boolean     @default(false)
  createdAt            DateTime    @default(now())

  sender             User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver           User                @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  calendarEvent      CalendarEvent?      @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  meetingReservation MeetingReservation? @relation(fields: [meetingReservationId], references: [id], onDelete: SetNull)

  @@unique([calendarEventId, receiverId])
  @@unique([meetingReservationId, receiverId])
  @@index([receiverId, isRead])
  @@index([receiverId, messageType, isRead])
  @@map("messages")
}

model NotificationSetting {
  userId                String  @id
  emailEnabled          Boolean @default(false)
  reminderMinutesBefore Int     @default(60)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

enum AnnouncementAudience {
  ALL
  MANAGERS
}

// 작업 알림(배포·점검) 영향 — 2026-10-01
enum WorkNoticeImpact {
  OUTAGE // 접속 중단
  PARTIAL // 일부 기능 제한
  NONE // 영향 없음
}

model Announcement {
  id                 String               @id @default(uuid())
  projectId          String
  title              String
  content            String
  audience           AnnouncementAudience @default(ALL)
  isImportant        Boolean              @default(false)
  showOnDashboard    Boolean              @default(false)
  dashboardVisibleTo DateTime?            @db.Date
  publishedAt        DateTime             @default(now())
  expiresAt          DateTime?            @db.Date
  // 작업 알림(2026-10-01) — 로그인 후 팝업, 안내 시작~작업 종료 동안 "오늘 하루 보지 않기"로 표시
  isWorkNotice       Boolean              @default(false)
  noticeStartAt      DateTime?
  workStartAt        DateTime?
  workEndAt          DateTime?
  workImpact         WorkNoticeImpact?
  viewCount          Int                  @default(0)
  authorId           String
  updatedById        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User    @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  updatedBy User    @relation("AnnouncementUpdater", fields: [updatedById], references: [id])

  @@index([projectId, deletedAt, isImportant, publishedAt])
  @@index([projectId, showOnDashboard, dashboardVisibleTo])
  @@index([projectId, isWorkNotice, workEndAt])
  @@map("announcements")
}

// ---------------------------------------------------------------------------
// 감사 로그
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  projectId   String?
  actorId     String?
  actorName   String?
  action      String
  targetTable String?
  targetId    String?
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?    @relation(fields: [actorId], references: [id])

  @@index([targetTable, targetId, createdAt])
  @@index([projectId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 회의실 예약
// ---------------------------------------------------------------------------

enum MeetingRoomType {
  LARGE
  SMALL
}

enum MeetingReservationStatus {
  CONFIRMED
  CANCELLED
}

enum RecurringMeetingPattern {
  DAILY
  WEEKLY
  MONTHLY
}

enum RecurringMeetingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MeetingChangeAction {
  CREATE
  CANCEL
  EXTEND
  SHORTEN
  UPDATE
}

model MeetingRoom {
  id        String          @id @default(uuid())
  projectId String
  name      String
  roomType  MeetingRoomType
  capacity  Int
  floor     String?
  equipment String[]        @default([])
  isActive  Boolean         @default(true)
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project      Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reservations MeetingReservation[]
  recurring    RecurringMeetingReservation[]

  @@unique([projectId, name])
  @@index([projectId, isActive, deletedAt])
  @@map("meeting_rooms")
}

model MeetingReservation {
  id          String                   @id @default(uuid())
  projectId   String
  roomId      String
  userId      String
  recurringId String?
  startAt     DateTime
  endAt       DateTime
  purpose     String
  status      MeetingReservationStatus @default(CONFIRMED)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  project   Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room      MeetingRoom                   @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user      User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  recurring RecurringMeetingReservation?  @relation(fields: [recurringId], references: [id], onDelete: Restrict)
  logs      MeetingReservationChangeLog[]
  attendees MeetingReservationAttendee[]
  messages  Message[]

  // recurringId+startAt의 실제 유일성은 status='CONFIRMED'인 행에만 적용되는 부분 유니크 인덱스로
  // DB에서 직접 관리한다(Prisma가 부분 인덱스를 표현하지 못해 @@unique 대신 일반 인덱스만 선언).
  // 정기예약 변경 시 취소된(CANCELLED) 기존 인스턴스와 동일한 (recurringId, startAt)로 새 인스턴스를
  // 다시 만들 수 있어야 하므로 필요하다 — 마이그레이션: 20260923020000_meeting_reservation_confirmed_unique.
  @@index([recurringId, startAt])
  @@index([projectId, startAt, endAt])
  @@index([roomId, startAt])
  @@index([userId, startAt])
  @@map("meeting_reservations")
}

model RecurringMeetingReservation {
  id            String                  @id @default(uuid())
  projectId     String
  roomId        String
  applicantId   String
  patternType   RecurringMeetingPattern
  patternDetail Json
  startMinutes  Int
  endMinutes    Int
  periodStart   DateTime                @db.Date
  periodEnd     DateTime                @db.Date
  purpose       String
  status        RecurringMeetingStatus  @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room         MeetingRoom          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  applicant    User                 @relation("RecurringApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  reviewer     User?                @relation("RecurringReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  reservations MeetingReservation[]

  @@index([projectId, status, createdAt])
  @@index([roomId, periodStart, periodEnd])
  @@map("recurring_meeting_reservations")
}

model MeetingReservationChangeLog {
  id            String              @id @default(uuid())
  reservationId String
  actorId       String
  action        MeetingChangeAction
  beforeStart   DateTime?
  beforeEnd     DateTime?
  afterStart    DateTime?
  afterEnd      DateTime?
  createdAt     DateTime            @default(now())

  reservation MeetingReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actor       User               @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reservationId, createdAt])
  @@map("meeting_reservation_change_logs")
}

model MeetingReservationAttendee {
  id            String   @id @default(uuid())
  reservationId String
  userId        String?
  guestName     String?
  createdAt     DateTime @default(now())

  reservation MeetingReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([reservationId, userId])
  @@index([userId, createdAt])
  @@map("meeting_reservation_attendees")
}

// ---------------------------------------------------------------------------
// WBS(작업분류체계)
// ---------------------------------------------------------------------------

enum WbsItemStatus {
  not_started
  in_progress
  completed
  on_hold
}

enum WbsItemEventType {
  created
  edited
  moved
  status_changed
  archived
}

model WbsItem {
  id                    String        @id @default(uuid())
  displayId             String        @unique
  projectId             String
  parentId              String?
  path                  String // 레벨당 4자리 고정폭 세그먼트("0001.0002.0007") — 문자열 정렬이 곧 트리 순서
  level                 Int // path 세그먼트 수(1부터 시작). path로부터 산출해 저장한다.
  name                  String
  description           String        @default("")
  ownerUserId           String?
  ownerNameRaw          String        @default("") // 엑셀 R&R(실행) 원본 텍스트 — 시스템 사용자와 매칭 안 돼도 표시·검색은 되도록 항상 보존
  ownerLoginId          String        @default("") // 엑셀 사용자ID 원본 텍스트 — 로그인 ID로 담당자를 확정 지정할 때 쓰며, 매칭 안 돼도 항상 보존
  groupId               String?
  startDate             DateTime?     @db.Date // 계획시작일 — 엑셀 StartDate 컬럼과 매핑되는 원본 필드명은 유지한다.
  dueDate               DateTime?     @db.Date // 계획종료일 — 엑셀 DueDate 컬럼과 매핑되는 원본 필드명은 유지한다.
  actualStartDate       DateTime?     @db.Date // 실적시작일 — 엑셀 47개 컬럼 서식에는 없는 웹 화면 전용 커스텀 컬럼(사용자ID와 동일 패턴).
  actualDueDate         DateTime?     @db.Date // 실적종료일 — 위와 동일.
  isDelayedCompletion   Boolean       @default(false) // 지연완료 — 실적종료일이 계획종료일보다 늦게 저장되면 true(1), 아니면 false(0).
  delayedCompletionDate DateTime?     @db.Date // 지연완료일자 — 지연완료 판정 시점의 실적종료일.
  delayDays             Int? // 지연일자 — 계획종료일 다음날부터 실적종료일까지의 영업일수(주말·공휴일 제외). 지연완료가 아니면 null.
  status                WbsItemStatus @default(not_started)
  configStatus          String        @default("") // 엑셀 D열(Confing Status) — 원본에도 용도가 불명확한 자유 텍스트 상태값
  weight                Decimal?      @db.Decimal(6, 2) // 엑셀 V열(가중치) 수동 입력값. null이면 상위 롤업 시 영업일수(U열 취지)로 대체한다.
  isUnitTestTarget      Boolean       @default(false) // 단위테스트 대상 — 개발 단계 Leaf 중 체크된 Task만 단위테스트 관리 대상(2026-10-21).
  createdBy             String
  version               Int           @default(1)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  archivedAt            DateTime?

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       WbsItem?         @relation("WbsTree", fields: [parentId], references: [id])
  children     WbsItem[]        @relation("WbsTree")
  owner        User?            @relation("WbsItemOwner", fields: [ownerUserId], references: [id])
  group        CommonCode?      @relation(fields: [groupId], references: [id])
  creator      User             @relation("WbsItemCreator", fields: [createdBy], references: [id])
  events       WbsItemEvent[]
  assignments  WbsAssignment[]
  deliverable  WbsDeliverable?
  delayedTasks WbsDelayedTask[]
  actionItems  ActionItem[]
  utProgramMaps  UtWbsProgramMap[]
  utCases        UtCase[]
  utMilestone    UtWbsMilestone?
  utMigrationsFrom UtWbsMigration[] @relation("UtMigrationFrom")
  utMigrationsTo   UtWbsMigration[] @relation("UtMigrationTo")

  @@index([projectId, archivedAt])
  @@index([projectId, path])
  @@index([parentId])
  @@map("wbs_items")
}

model WbsItemSequence {
  projectId String @id
  value     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("wbs_item_sequences")
}

model WbsItemEvent {
  id         String           @id @default(uuid())
  wbsItemId  String
  eventType  WbsItemEventType
  actorId    String?
  actorName  String?
  body       String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime         @default(now())

  wbsItem WbsItem @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([wbsItemId, createdAt])
  @@map("wbs_item_events")
}

// 엑셀 Y~AH(역할별 진척등록권한) + AI~AR(역할별 진도율)을 역할(행)로 정규화한 것.
// 역할(Track) 목록은 다른 모듈(이슈·업무일지 등)과 공유하는 Groups(WORK_MODULE)가 아니라, WBS 전용 공통코드
// 그룹("WBS_WORK_GROUP")의 CommonCode를 쓴다 — 다른 모듈의 업무그룹 구성과 무관하게 WBS 고유 10개 역할을 유지한다.
model WbsAssignment {
  id              String   @id @default(uuid())
  wbsItemId       String
  groupId         String
  progressPercent Int      @default(0)
  updatedBy       String
  updatedAt       DateTime @updatedAt

  wbsItem WbsItem    @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)
  group   CommonCode @relation(fields: [groupId], references: [id])
  updater User       @relation("WbsAssignmentUpdater", fields: [updatedBy], references: [id])

  @@unique([wbsItemId, groupId])
  @@map("wbs_assignments")
}

// 엑셀 N(Deliverables 이슈/사유), O(공식여부), P(파일위치), R(산출물템플릿), S(검수자), T(검수실행일)
model WbsDeliverable {
  id             String    @id @default(uuid())
  wbsItemId      String    @unique
  note           String    @default("")
  isOfficial     Boolean   @default(false)
  fileUrl        String    @default("")
  templateUrl    String    @default("")
  reviewerUserId String?
  reviewedAt     DateTime? @db.Date
  updatedAt      DateTime  @updatedAt

  wbsItem  WbsItem @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("WbsDeliverableReviewer", fields: [reviewerUserId], references: [id])

  @@map("wbs_deliverables")
}

// 실적종료일 저장 시 지연일자(영업일)가 1 이상이면 자동으로 한 건 남기는 지연 이력 로그(2026-09-05 사용자 요청).
// 현재 상태를 대표하는 단일 레코드가 아니라 "실적종료일이 갱신될 때마다" 쌓이는 이력이라, 조회 시점 조인 대신
// 테스크명·업무그룹·담당자를 등록 시점 값으로 스냅샷 보존한다(이후 WBS 항목이 바뀌어도 로그는 그대로 남는다).
model WbsDelayedTask {
  id                    String    @id @default(uuid())
  projectId             String
  wbsItemId             String
  name                  String // 테스크명(등록 시점 스냅샷)
  plannedStartDate      DateTime? @db.Date // 계획시작일
  plannedDueDate        DateTime? @db.Date // 계획종료일
  actualStartDate       DateTime? @db.Date // 실적시작일
  actualDueDate         DateTime  @db.Date // 실적종료일
  delayedCompletionDate DateTime  @db.Date // 지연종료일(실적종료일과 동일 — 지연 확정 시점 값)
  delayDays             Int // 지연일(영업일)
  groupLabel            String? // 업무그룹(등록 시점 스냅샷)
  ownerName             String? // 담당자(등록 시점 스냅샷)
  createdAt             DateTime  @default(now()) // 등록일자

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsItem WbsItem @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([wbsItemId])
  @@map("wbs_delayed_tasks")
}

// 엑셀 W열(Sort/Working Day = NETWORKDAYS)이 참조하던 외부 [1]공휴일 워크북 링크를 대체한다.
model Holiday {
  id        String   @id @default(uuid())
  projectId String? // null이면 프로젝트 공통(전사) 공휴일
  date      DateTime @db.Date
  label     String

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@map("holidays")
}

// MAIN: pmotools 로그인 화면 / ADMIN: pmotools_admin(백오피스) 로그인 화면.
// pmotools_admin 스키마에서도 동일하게 선언되는 공유 테이블이며, pmotools는 MAIN 행만 사용한다.
enum MenuAppScope {
  MAIN
  ADMIN
}

model LoginImage {
  id        String       @id @default(uuid())
  scope     MenuAppScope @unique
  data      Bytes
  mimeType  String
  updatedAt DateTime     @updatedAt
  updatedBy String?

  @@map("login_images")
}

// ---------------------------------------------------------------------------
// 회의록 — 회의록 양식(EOCP_YYYYMMDD_분류_제목.pdf)의 항목 구성을 그대로 따른다.
// 1단계는 등록·조회·수정·보관과 인쇄(PDF)까지이며 확정(승인) 절차는 두지 않는다(2026-09-28 사용자 결정).
// ---------------------------------------------------------------------------

enum MeetingAttendeeSide {
  CUSTOMER // 발주사
  VENDOR // 수행사
}

enum MeetingMinuteSection {
  CONTENT // 회의 내용 (내용 + 이슈/비고)
  DECISION // 결정사항 (내용 + 진행 예정 일정)
  NOTE // 특이사항
}

model MeetingMinuteSequence {
  projectId String @id
  value     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("meeting_minute_sequences")
}

model MeetingMinute {
  id          String    @id @default(uuid())
  displayId   String // MM-0001 — 프로젝트 안에서만 유일 (프로젝트마다 순번이 1부터라 전역 유일이면 두 번째 프로젝트에서 충돌)
  seq         Int
  projectId   String
  category    String // 회의 분류(예: DES) — 우선 수기 입력, 이후 공통코드로 전환 예정
  title       String // 회의 안건
  meetingDate DateTime  @db.Date
  sessions    Json // 회의 시간대 [{ "start": "09:30", "end": "12:00" }, ...] — 오전·오후처럼 여러 회차 허용
  location    String    @default("")
  authorName  String // 양식의 "작성자" — 등록한 사용자와 다를 수 있어 텍스트로 보존
  createdBy   String // 등록자 — 수정·보관 권한 판정 기준
  updatedBy   String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User                      @relation("MeetingMinuteCreator", fields: [createdBy], references: [id])
  attendees   MeetingMinuteAttendee[]
  entries     MeetingMinuteEntry[]
  actionItems MeetingMinuteActionItem[]

  @@unique([projectId, displayId])
  @@index([projectId, archivedAt, meetingDate])
  @@map("meeting_minutes")
}

model MeetingMinuteAttendee {
  id        String              @id @default(uuid())
  minuteId  String
  side      MeetingAttendeeSide
  userId    String? // 시스템 사용자면 연결, 조직·역할 표기("BO 기획")나 외부인은 null
  name      String
  sortOrder Int                 @default(0)

  minute MeetingMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([minuteId])
  @@map("meeting_minute_attendees")
}

model MeetingMinuteEntry {
  id              String               @id @default(uuid())
  minuteId        String
  section         MeetingMinuteSection
  sortOrder       Int                  @default(0)
  content         String
  remark          String               @default("") // 회의 내용: 이슈/비고
  plannedSchedule String               @default("") // 결정사항: 진행 예정 일정 ("10월 중" 같은 표현도 허용)

  minute MeetingMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)

  @@index([minuteId, section])
  @@map("meeting_minute_entries")
}

model MeetingMinuteActionItem {
  id           String    @id @default(uuid())
  minuteId     String
  sortOrder    Int       @default(0)
  title        String // Action Item
  content      String    @default("")
  assigneeId   String? // 시스템 사용자 담당자
  assigneeName String    @default("") // 표시용 담당자명 — 외부인 담당자도 허용
  dueDate      DateTime? @db.Date
  // 진행상태(2026-09-30) — 프로젝트 멤버 누구나 변경, 변경 이력은 meeting_minute_action_item_logs
  status          MeetingActionItemStatus @default(WAITING)
  statusChangedAt DateTime?
  statusChangedBy String?

  minute        MeetingMinute                @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  assignee      User?                        @relation("MeetingActionItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  statusChanger User?                        @relation("MeetingActionItemStatusChanger", fields: [statusChangedBy], references: [id], onDelete: SetNull)
  statusLogs    MeetingMinuteActionItemLog[]

  @@index([minuteId])
  @@index([assigneeId])
  @@index([status])
  @@map("meeting_minute_action_items")
}

enum MeetingActionItemStatus {
  WAITING // 대기
  IN_PROGRESS // 진행
  ON_HOLD // 보류
  DONE // 완료
}

model MeetingMinuteActionItemLog {
  id           String                   @id @default(uuid())
  actionItemId String
  fromStatus   MeetingActionItemStatus?
  toStatus     MeetingActionItemStatus
  memo         String                   @default("")
  actorId      String
  createdAt    DateTime                 @default(now())

  actionItem MeetingMinuteActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  actor      User                    @relation("MeetingActionItemLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actionItemId, createdAt])
  @@map("meeting_minute_action_item_logs")
}

// ---------------------------------------------------------------------------
// 엑셀 업로드 임시 저장(스테이징) — WBS2 · 요구사항관리2 (2026-09-30)
// 업로드한 엑셀을 반영 전에 담아 두고 행별 정상/오류를 보여 준다. 오류 행은 화면에서 고쳐 재검증하고, 반영하면 배치를 지운다.
// (프로젝트, 종류, 올린 사람)당 배치 1개 — 재업로드하면 교체. 올린 사람만 보고 수정·반영한다.
// ---------------------------------------------------------------------------

enum ImportBatchKind {
  WBS
  REQUIREMENT
  UT_CASE
}

enum ImportRowStatus {
  OK
  ERROR
}

model ImportBatch {
  id         String          @id @default(uuid())
  projectId  String
  kind       ImportBatchKind
  fileName   String
  headers    Json // 1행 헤더(열 순서대로 문자열 배열)
  summary    Json // 마지막 검증 요약 { total, ok, error, actionCounts?, willDeleteCount? , fileErrors[] }
  uploadedBy String
  version    Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User             @relation("ImportBatchUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)
  rows     ImportBatchRow[]

  @@unique([projectId, kind, uploadedBy])
  @@map("import_batches")
}

model ImportBatchRow {
  id       String          @id @default(uuid())
  batchId  String
  rowNo    Int // 엑셀 행 번호(2부터) — 검증 메시지·화면 표시에 그대로 쓴다
  cells    Json // 열 순서대로 값 배열(날짜는 YYYY-MM-DD, 리치텍스트·수식은 표시값)
  status   ImportRowStatus @default(OK)
  errors   Json            @default("[]")
  warnings Json            @default("[]")
  edited   Boolean         @default(false)
  editedAt DateTime?

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNo])
  @@map("import_batch_rows")
}

// ---------------------------------------------------------------------------
// 배치 작업 이력 (DB 자동 백업 등)
// ---------------------------------------------------------------------------
model BatchJobLog {
  id         String   @id @default(uuid())
  jobName    String
  status     String
  output     String?
  durationMs Int?
  executedAt DateTime @default(now())

  @@index([jobName, executedAt])
  @@map("batch_job_logs")
}

// ---------------------------------------------------------------------------
// 단위테스트 수행관리 (설계: docs/단위테스트 수행관리 프로그램 설계서.md 4장, 2026-10-20 Phase 1)
// 1단계 수기 관리 — UT 데이터는 기존 WBS 진척(실적일·역할 트랙)을 변경하지 않는다.
// 하위 행의 projectId·wbsItemId는 상위 행 값을 저장 시 복사한 비정규화 컬럼(FK 없음, 인덱스만) — 4.3 규칙 1·3.
// 수행 결과·승인·증적·결함 조치 이력은 INSERT 전용(수기 마이그레이션의 트리거로 강제) — 4.3 규칙 6.
// ---------------------------------------------------------------------------

enum UtCaseStatus {
  DRAFT            // 작성중
  REVIEW_REQUESTED // 검토요청
  APPROVED         // 승인
  REJECTED         // 반려(PL 검토) — 시나리오 제거로 케이스 단위 검토(2026-10-21)
  IN_EXECUTION     // 수행중(최초 수행 등록 또는 Fail·반려 후 재수행 대기)
  QC_PENDING       // Pass(QC대기)
  PL_PENDING       // QC확인(PL대기)
  PL_CONFIRMED     // PL확인완료
}

enum UtVerdict {
  PASS
  FAIL
  BLOCKED
  NA
}

enum UtApprovalStatus {
  QC_PENDING
  PL_PENDING
  APPROVED
  REJECTED
}

enum UtApprovalStep {
  QC
  PL
}

enum UtDecision {
  APPROVED
  REJECTED
}

enum UtProgramType {
  SCREEN
  API
  BATCH
  REPORT
}

enum UtDefectSeverity {
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum UtDefectStatus {
  REGISTERED // 등록
  FIXED      // 조치완료
  VERIFIED   // 검증완료
  REFIX      // 재조치(검증 부적합)
}

enum UtVerificationResult {
  PASS // 적합
  FAIL // 부적합
}

enum UtDefectActionType {
  FIX
  VERIFY
}

enum UtWbsChangeType {
  SPLIT
  MERGE
  ARCHIVE
  LEAF_LOST
}

model UtProjectSetting {
  projectId    String    @id
  utStartDate  DateTime? @db.Date
  utEndDate    DateTime? @db.Date
  samplingRate Int       @default(10) // PMO 샘플링 비율(%)
  lockedAt     DateTime? // 마감 잠금 — 기록되면 UT 데이터 쓰기 차단(4.3 규칙 8)
  lockedBy     String?
  lockReason   String    @default("")
  updatedBy    String?
  version      Int       @default(1)
  updatedAt    DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locker  User?   @relation("UtProjectLocker", fields: [lockedBy], references: [id])

  @@map("ut_project_settings")
}

model UtProgram {
  id          String        @id @default(uuid())
  projectId   String
  programCode String
  name        String
  programType UtProgramType @default(SCREEN)
  screenId    String        @default("")
  groupId     String? // Groups(WORK_MODULE)
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group     Groups?           @relation("UtProgramGroup", fields: [groupId], references: [id], onDelete: SetNull)
  creator   User              @relation("UtProgramCreator", fields: [createdBy], references: [id])
  wbsMaps   UtWbsProgramMap[]

  @@unique([projectId, programCode])
  @@map("ut_programs")
}

model UtWbsProgramMap {
  wbsItemId String
  programId String
  createdAt DateTime @default(now())

  wbsItem WbsItem   @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)
  program UtProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([wbsItemId, programId])
  @@map("ut_wbs_program_maps")
}

// 테스트 케이스 — 시나리오 없이 WBS Task(또는 WBS 없음)에 바로 속한다(2026-10-21 사용자 확정: 단위테스트 단계에는 시나리오 불필요).
model UtCase {
  id                String       @id @default(uuid())
  projectId         String
  wbsItemId         String? // WBS 없이 등록한 테스트는 null(2026-10-21). 이관 처리에서만 변경
  displayId         String // UTC-{WBS displayId에서 "WBS-" 제외}-{순번 3자리}, WBS 없음은 UTC-NOWBS-{순번 4자리}
  seq               Int
  groupId           String // 업무단위 = Groups(WORK_MODULE), 수기 선택(4.4)
  screenId          String       @default("") // 화면ID — 수기 입력(2026-10-21 사용자 확정, 프로그램 선택 대체)
  screenName        String       @default("") // 화면명 — 수기 입력
  screenUrl         String       @default("") // 화면 URL — 수기 입력(2026-10-23)
  requirementId     String?
  plUserId          String? // PL 확인자 수기 지정(4.4)
  workerUserId      String? // 작업자 = 저장 시점의 WBS Task 담당자 스냅샷(2026-10-23). 담당자가 사용자 목록에 없으면 null
  workerName        String       @default("") // 작업자 이름 스냅샷(사용자 없이 이름만 있는 담당자 포함)
  reviewRequestedAt DateTime?
  approvedAt        DateTime?
  approvedBy        String?
  rejectReason      String       @default("")
  caseTypeCodeId String? // 케이스유형 — 공통코드 ut_case_type(화면·기능·API), 2026-10-21 사용자 확정
  name           String // 테스트 대상(검증 규칙 1개)
  precondition   String       @default("")
  steps          String       @default("") // 테스트스텝
  inputData      String       @default("")
  expectedResult String       @default("")
  executorId     String?
  plannedDate    DateTime?    @db.Date
  qcUserId       String?
  status         UtCaseStatus @default(DRAFT)
  isActive       Boolean      @default(true)
  createdBy      String
  updatedBy      String?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsItem     WbsItem?         @relation(fields: [wbsItemId], references: [id], onDelete: Restrict)
  group       Groups           @relation("UtCaseGroup", fields: [groupId], references: [id], onDelete: Restrict)
  requirement Requirement?     @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  pl          User?            @relation("UtCasePl", fields: [plUserId], references: [id])
  approver    User?            @relation("UtCaseApprover", fields: [approvedBy], references: [id])
  caseTypeCode CommonCode?     @relation("UtCaseTypeCode", fields: [caseTypeCodeId], references: [id], onDelete: SetNull)
  migrations  UtWbsMigration[]
  executor   User?         @relation("UtCaseExecutor", fields: [executorId], references: [id])
  qc         User?         @relation("UtCaseQc", fields: [qcUserId], references: [id])
  creator    User          @relation("UtCaseCreator", fields: [createdBy], references: [id])
  worker     User?         @relation("UtCaseWorker", fields: [workerUserId], references: [id], onDelete: SetNull)
  executions UtExecution[]
  defects    UtDefect[]

  @@unique([projectId, displayId])
  @@index([projectId, isActive, status])
  @@index([wbsItemId])
  @@index([plUserId, status])
  @@index([executorId, status])
  @@index([qcUserId, status])
  @@index([workerUserId])
  @@map("ut_cases")
}

model UtExecution {
  id                String            @id @default(uuid())
  projectId         String
  caseId            String
  wbsItemId         String?
  roundNo           Int
  envCodeId         String? // CommonCode(ut_env)
  executorId        String
  executedOn        DateTime          @db.Date // 테스트수행일
  actualResult      String            @default("")
  verdict           UtVerdict
  naReason          String            @default("")
  approvalStatus    UtApprovalStatus? // PASS → QC_PENDING, NA → PL_PENDING, FAIL·BLOCKED → null
  approvalUpdatedAt DateTime? // approvalStatus 갱신만 허용(트리거)
  createdAt         DateTime          @default(now())

  case          UtCase       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  env           CommonCode?  @relation("UtExecutionEnv", fields: [envCodeId], references: [id], onDelete: SetNull)
  executor      User         @relation("UtExecutionExecutor", fields: [executorId], references: [id])
  approvals     UtApproval[]
  evidences     UtEvidence[]
  defects       UtDefect[]   @relation("UtDefectFoundIn")
  retestDefects UtDefect[]   @relation("UtDefectRetest")

  @@unique([caseId, roundNo])
  @@index([projectId, approvalStatus])
  @@index([wbsItemId])
  @@map("ut_executions")
}

model UtApproval {
  id                 String         @id @default(uuid())
  projectId          String
  executionId        String
  wbsItemId          String?
  step               UtApprovalStep
  approverId         String
  decision           UtDecision
  rejectReasonCodeId String? // CommonCode(ut_reject_reason)
  comment            String         @default("")
  actedAt            DateTime       @default(now())

  execution    UtExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  approver     User        @relation("UtApprovalApprover", fields: [approverId], references: [id])
  rejectReason CommonCode? @relation("UtApprovalRejectReason", fields: [rejectReasonCodeId], references: [id], onDelete: SetNull)

  @@unique([executionId, step])
  @@index([projectId, step])
  @@map("ut_approvals")
}

model UtEvidence {
  id          String   @id @default(uuid())
  projectId   String
  executionId String
  fileName    String // 원본 파일명
  storageKey  String   @unique // 저장소 상대경로 {프로젝트코드}/{yyyy}/{MM}/{id}.{확장자}
  sizeBytes   Int
  mimeType    String
  sha256      String
  uploadedBy  String
  uploadedAt  DateTime @default(now())

  execution UtExecution      @relation(fields: [executionId], references: [id], onDelete: Restrict)
  uploader  User             @relation("UtEvidenceUploader", fields: [uploadedBy], references: [id])
  views     UtEvidenceView[]

  @@index([executionId])
  @@map("ut_evidences")
}

model UtEvidenceView {
  id         String   @id @default(uuid())
  evidenceId String
  viewerId   String
  viewedAt   DateTime @default(now())

  evidence UtEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  viewer   User       @relation("UtEvidenceViewer", fields: [viewerId], references: [id])

  @@index([evidenceId, viewerId])
  @@map("ut_evidence_views")
}

model UtDefect {
  id                 String                @id @default(uuid())
  projectId          String
  displayId          String // DF-{yyMMdd}-{순번 4자리}
  executionId        String
  caseId             String
  wbsItemId          String?
  description        String // 결함내용(C9)
  severity           UtDefectSeverity      @default(MAJOR)
  defectTypeCodeId   String? // CommonCode(ut_defect_type)
  causeGroupId       String? // Groups(WORK_MODULE)
  vendorGroupId      String? // Groups(COMPANY) — 프로젝트에 협력사 그룹이 있으면 입력 필수(서버 검증)
  assigneeId         String? // 조치 담당 지정
  status             UtDefectStatus        @default(REGISTERED)
  foundAt            DateTime              @db.Date
  fixedAt            DateTime?             @db.Date // 조치일
  fixedBy            String? // 조치자
  verificationResult UtVerificationResult? // 검증결과(적합/부적합)
  verifiedAt         DateTime?             @db.Date // 검증일자
  verifiedBy         String? // 검증자 — 조치자와 달라야 함(4.3 규칙 5)
  retestExecutionId  String?
  createdBy          String
  updatedBy          String?
  version            Int                   @default(1)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  execution   UtExecution       @relation("UtDefectFoundIn", fields: [executionId], references: [id], onDelete: Restrict)
  retest      UtExecution?      @relation("UtDefectRetest", fields: [retestExecutionId], references: [id], onDelete: SetNull)
  case        UtCase            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  defectType  CommonCode?       @relation("UtDefectType", fields: [defectTypeCodeId], references: [id], onDelete: SetNull)
  causeGroup  Groups?           @relation("UtDefectCauseGroup", fields: [causeGroupId], references: [id], onDelete: SetNull)
  vendorGroup Groups?           @relation("UtDefectVendorGroup", fields: [vendorGroupId], references: [id], onDelete: SetNull)
  assignee    User?             @relation("UtDefectAssignee", fields: [assigneeId], references: [id])
  fixer       User?             @relation("UtDefectFixer", fields: [fixedBy], references: [id])
  verifier    User?             @relation("UtDefectVerifier", fields: [verifiedBy], references: [id])
  creator     User              @relation("UtDefectCreator", fields: [createdBy], references: [id])
  actions     UtDefectAction[]

  @@unique([projectId, displayId])
  @@index([projectId, status])
  @@index([caseId])
  @@index([assigneeId, status])
  @@map("ut_defects")
}

model UtDefectAction {
  id                 String                @id @default(uuid())
  defectId           String
  actionType         UtDefectActionType
  actedBy            String
  actedOn            DateTime              @db.Date
  verificationResult UtVerificationResult?
  note               String                @default("")
  createdAt          DateTime              @default(now())

  defect UtDefect @relation(fields: [defectId], references: [id], onDelete: Restrict)
  actor  User     @relation("UtDefectActionActor", fields: [actedBy], references: [id])

  @@index([defectId])
  @@map("ut_defect_actions")
}

model UtWbsMilestone {
  wbsItemId      String    @id
  projectId      String
  devCompletedOn DateTime? @db.Date // 개발완료일(개발자 입력)
  devDeclaredBy  String?
  devConfirmedBy String? // PL 확인
  devConfirmedAt DateTime?
  utCompletedOn  DateTime? @db.Date // UT완료일(PL 기록)
  utRecordedBy   String?
  utRecordedAt   DateTime?
  note           String    @default("")
  version        Int       @default(1)
  updatedAt      DateTime  @updatedAt

  wbsItem   WbsItem @relation(fields: [wbsItemId], references: [id], onDelete: Restrict)
  declarer  User?   @relation("UtMilestoneDeclarer", fields: [devDeclaredBy], references: [id])
  confirmer User?   @relation("UtMilestoneConfirmer", fields: [devConfirmedBy], references: [id])
  recorder  User?   @relation("UtMilestoneRecorder", fields: [utRecordedBy], references: [id])

  @@index([projectId])
  @@map("ut_wbs_milestones")
}

model UtWbsMigration {
  id            String          @id @default(uuid())
  projectId     String
  caseId        String
  fromWbsItemId String
  toWbsItemId   String
  changeType    UtWbsChangeType
  migratedBy    String
  migratedAt    DateTime        @default(now())

  case     UtCase     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  fromWbs  WbsItem    @relation("UtMigrationFrom", fields: [fromWbsItemId], references: [id], onDelete: Restrict)
  toWbs    WbsItem    @relation("UtMigrationTo", fields: [toWbsItemId], references: [id], onDelete: Restrict)
  migrator User       @relation("UtMigrationMigrator", fields: [migratedBy], references: [id])

  @@index([projectId])
  @@map("ut_wbs_migrations")
}

model UtSequence {
  scope String @id // case:{wbsItemId} · case:nowbs:{projectId} · defect:{projectId}:{yyMMdd}
  value Int    @default(0)

  @@map("ut_sequences")
}

// ---------------------------------------------------------------------------
// 결함관리 (설계: docs/결함관리 프로그램 설계서.md, 2026-10-24 승인)
// 규칙 1: 단위테스트(ut_*) 테이블에는 외래 키·역관계를 두지 않는다 — caseId·executionId는 소프트 참조(문자열 id).
// wbsItemId·requirementId도 소프트 참조로 두어 WbsItem·Requirement 모델 정의를 바꾸지 않는다.
// 결함 번호 체계: DF-{yyMMdd}-{순번 4자리}, 결함관리 순번은 5001~9999(단위테스트 0001~4999와 겹치지 않음) — 설계서 3.4.
// ---------------------------------------------------------------------------

enum DefectSource {
  MANUAL    // 결함 화면에서 직접 등록
  ENTRY     // 단위테스트 화면에서 확장·위젯으로 진입해 등록
  WIDGET    // 테스트 대상 사이트의 위젯
  EXTENSION // Chrome 확장 프로그램
}

enum DefectStatusClassType {
  OPEN   // 미조치
  DONE   // 조치완료
  CLOSED // 종결
}

enum DefectHistoryAction {
  CREATE
  UPDATE
  ASSIGN
  STATUS
  LINK
  DELETE
}

model Defect {
  id                   String       @id @default(uuid())
  projectId            String
  displayId            String // DF-{yyMMdd}-{5001~9999}
  seq                  Int // 같은 날짜의 결함관리 순번(5001~9999)
  title                String
  stepsToRepro         String       @default("")
  testStageCodeId      String // 공통코드 defect_test_stage
  severityCodeId       String // 공통코드 defect_severity — 결함 자체의 영향도(조치 상태와 별개)
  priorityCodeId       String? // 공통코드 defect_priority
  statusCodeId         String // 공통코드 defect_status — 분류는 defect_status_classes
  identificationCodeId String? // 공통코드 defect_identification
  screenPath           String       @default("") // 화면경로(선택): 직접 입력·화면 목록 선택·수집 URL 자동 매칭
  menuName             String       @default("")
  screenName           String       @default("")
  screenUrl            String       @default("") // 결함 수집 시 획득한 URL(http/https)
  envInfo              String       @default("")
  groupId              String? // 업무단위(Groups) — 업무그룹리더 판정
  wbsItemId            String? // 소프트 참조(wbs_items)
  caseId               String? // 소프트 참조(ut_cases) — 규칙 1: FK 없음
  executionId          String? // 소프트 참조(ut_executions) — 규칙 1: FK 없음
  requirementId        String? // 소프트 참조(requirements)
  createdBy            String // 등록자
  assigneeUserId       String? // 조치 담당자(null = 미지정). 기본값: WBS Task의 작업자
  actionComment        String       @default("")
  actionDueDate        DateTime?    @db.Date
  actionStartDate      DateTime?    @db.Date
  actionEndDate        DateTime?    @db.Date
  sourceType           DefectSource @default(MANUAL)
  sourceMeta           Json? // 위젯·확장이 보낸 pageUrl·pageTitle·userAgent
  isActive             Boolean      @default(true) // 논리 삭제
  version              Int          @default(1)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testStage      CommonCode      @relation("DefectTestStage", fields: [testStageCodeId], references: [id], onDelete: Restrict)
  severity       CommonCode      @relation("DefectSeverity", fields: [severityCodeId], references: [id], onDelete: Restrict)
  priority       CommonCode?     @relation("DefectPriority", fields: [priorityCodeId], references: [id], onDelete: SetNull)
  status         CommonCode      @relation("DefectStatus", fields: [statusCodeId], references: [id], onDelete: Restrict)
  identification CommonCode?     @relation("DefectIdentification", fields: [identificationCodeId], references: [id], onDelete: SetNull)
  group          Groups?         @relation("DefectGroup", fields: [groupId], references: [id], onDelete: SetNull)
  creator        User            @relation("DefectCreator", fields: [createdBy], references: [id])
  assignee       User?           @relation("DefectAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  histories      DefectHistory[]
  evidences      DefectEvidence[]

  @@unique([projectId, displayId])
  @@index([projectId, isActive, statusCodeId])
  @@index([projectId, testStageCodeId])
  @@index([projectId, createdAt])
  @@index([assigneeUserId])
  @@index([createdBy])
  @@index([caseId])
  @@index([wbsItemId])
  @@index([groupId])
  @@map("defects")
}

// 이력 — INSERT 전용(마이그레이션의 트리거로 강제). 증적 원문은 복사하지 않는다.
model DefectHistory {
  id                 String              @id @default(uuid())
  defectId           String
  action             DefectHistoryAction
  statusBeforeCodeId String?
  statusAfterCodeId  String?
  changedData        Json                @default("{}") // { 필드: { before, after } }
  actorId            String
  actorName          String
  createdAt          DateTime            @default(now())

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Restrict)

  @@index([defectId, createdAt])
  @@map("defect_histories")
}

// 증적 — INSERT 전용. 파일은 서버 디스크(증적 저장소)에 저장한다.
model DefectEvidence {
  id         String   @id @default(uuid())
  projectId  String
  defectId   String
  fileName   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  storageKey String   @unique
  uploadedBy String
  createdAt  DateTime @default(now())

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Restrict)

  @@index([defectId])
  @@index([projectId])
  @@map("defect_evidences")
}

// 상태 코드를 통계 기준(미조치·조치완료·종결)으로 묶는다.
model DefectStatusClass {
  id          String                @id @default(uuid())
  projectId   String
  statusCodeId String
  statusClass DefectStatusClassType
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusCode CommonCode @relation("DefectStatusClassCode", fields: [statusCodeId], references: [id], onDelete: Cascade)

  @@unique([projectId, statusCodeId])
  @@map("defect_status_classes")
}

// "미조치 중대 결함" 기준 — 심각도 코드별 중대 여부(기본 Critical·Major).
model DefectSeveritySetting {
  id             String   @id @default(uuid())
  projectId      String
  severityCodeId String
  isMajorImpact  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  severityCode CommonCode @relation("DefectSeveritySettingCode", fields: [severityCodeId], references: [id], onDelete: Cascade)

  @@unique([projectId, severityCodeId])
  @@map("defect_severity_settings")
}

// WBS Task – 테스트 단계 연결. 결함관리 전용 신규 테이블이며 wbs_items·단위테스트 대상 판정은 바꾸지 않는다(규칙 1).
model WbsItemTestStage {
  id              String   @id @default(uuid())
  projectId       String
  wbsItemId       String // 소프트 참조(wbs_items)
  testStageCodeId String
  createdBy       String
  createdAt       DateTime @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testStage CommonCode @relation("WbsItemTestStageCode", fields: [testStageCodeId], references: [id], onDelete: Cascade)

  @@unique([wbsItemId, testStageCodeId])
  @@index([projectId, testStageCodeId])
  @@map("wbs_item_test_stages")
}

// 위젯·확장 프로그램이 동작할 테스트 대상 사이트(허용 출처).
model DefectTargetSite {
  id        String   @id @default(uuid())
  projectId String
  name      String
  origin    String // 예: http://localhost:8080
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, origin])
  @@map("defect_target_sites")
}

// 화면 목록 — 엑셀 일괄 등록, 결함 등록 때 화면경로 선택·수집 URL 자동 매칭. pathKey는 공백 제거·소문자 비교용 유일 키.
model DefectScreen {
  id        String   @id @default(uuid())
  projectId String
  path      String
  pathKey   String
  url       String?
  name      String   @default("")
  isActive  Boolean  @default(true)
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, pathKey])
  @@index([projectId, isActive])
  @@map("defect_screens")
}

// 채번 — scope: defect:{projectId}:{yyMMdd}, 값은 5000에서 시작해 1씩 증가(발번 값 5001~9999).
model DefectSequence {
  scope String @id
  value Int    @default(5000)

  @@map("defect_sequences")
}
