// PMS 통합 스키마 — 단일 Postgres(Supabase) 스키마.
// 매핑 근거: docs/PMS_캘린더기반_재개발계획서.md 3장

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 인증 / 사용자
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  MEMBER
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum UserStatus {
  ACTIVE
  LOCKED
}

model User {
  id           String     @id @default(uuid())
  userId       String     @unique // 로그인 ID
  name         String
  passwordHash String
  email        String?
  department   String?
  jobTitle     String?
  role         UserRole   @default(MEMBER)
  theme        ThemeMode  @default(SYSTEM)
  status       UserStatus @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships                   ProjectMember[]
  groupMemberships              UserGroupMap[]
  ledWorkGroups                 Groups[]                      @relation("WorkGroupLeader")
  createdIssues                 Issue[]                       @relation("IssueCreator")
  ownedIssues                   Issue[]                       @relation("IssueOwner")
  lastModifiedIssues            Issue[]                       @relation("IssueLastModifier")
  ownedIssueProgressEntries     IssueProgress[]               @relation("IssueProgressOwner")
  actedIssueProgressEntries     IssueProgress[]               @relation("IssueProgressActor")
  assignedEvents                EventAssignee[]
  createdEvents                 CalendarEvent[]               @relation("CalendarEventCreator")
  updatedEvents                 CalendarEvent[]               @relation("CalendarEventUpdater")
  createdWeeklyReports          WeeklyReport[]                @relation("WeeklyReportCreator")
  createdProgress               WeeklyProgress[]              @relation("WeeklyProgressCreator")
  createdStaffChanges           StaffChange[]                 @relation("StaffChangeCreator")
  notificationSetting           NotificationSetting?
  sentMessages                  Message[]                     @relation("MessageSender")
  receivedMessages              Message[]                     @relation("MessageReceiver")
  auditLogs                     AuditLog[]
  meetingReservations           MeetingReservation[]
  recurringMeetings             RecurringMeetingReservation[] @relation("RecurringApplicant")
  reviewedMeetings              RecurringMeetingReservation[] @relation("RecurringReviewer")
  meetingChangeLogs             MeetingReservationChangeLog[]
  meetingAttendances            MeetingReservationAttendee[]
  createdRequirements           Requirement[]                 @relation("RequirementCreator")
  ownedRequirements             Requirement[]                 @relation("RequirementOwner")
  requirementEvents             RequirementEvent[]
  requestedRequirementChanges   RequirementChange[]           @relation("RequirementChangeRequester")
  decidedRequirementChanges     RequirementChange[]           @relation("RequirementChangeDecider")
  passwordResetRequests         PasswordResetRequest[]        @relation("PasswordResetRequestUser")
  resolvedPasswordResetRequests PasswordResetRequest[]        @relation("PasswordResetRequestResolver")
  createdAnnouncements          Announcement[]                @relation("AnnouncementAuthor")
  updatedAnnouncements          Announcement[]                @relation("AnnouncementUpdater")
  createdManagementTasks        ManagementTask[]              @relation("ManagementTaskCreator")
  assignedManagementTasks       ManagementTaskAssignee[]
  createdPmoDailySnapshots      PmoDailySnapshot[]            @relation("PmoDailySnapshotCreator")
  createdPmoDelayedTasks        PmoDelayedTask[]              @relation("PmoDelayedTaskCreator")
  assignedPmoDelayedTasks       PmoDelayedTaskAssignee[]
  createdManagementTaskLinks    ManagementTaskLink[]          @relation("ManagementTaskLinkCreator")
  assignedActionItems           ActionItem[]                  @relation("ActionItemAssignee")
  createdActionItems            ActionItem[]                  @relation("ActionItemCreator")
  generatedWeeklySummaries      WeeklySummary[]               @relation("WeeklySummaryGenerator")
  workLogs                      WorkLog[]                     @relation("WorkLogAssignee")
  createdWbsItems               WbsItem[]                     @relation("WbsItemCreator")
  ownedWbsItems                 WbsItem[]                     @relation("WbsItemOwner")
  wbsItemEvents                 WbsItemEvent[]
  wbsAssignmentUpdates          WbsAssignment[]               @relation("WbsAssignmentUpdater")
  reviewedWbsDeliverables       WbsDeliverable[]              @relation("WbsDeliverableReviewer")
  createdMeetingMinutes         MeetingMinute[]               @relation("MeetingMinuteCreator")
  meetingMinuteAttendances      MeetingMinuteAttendee[]
  meetingMinuteActionItems      MeetingMinuteActionItem[]     @relation("MeetingActionItemAssignee")
  meetingActionItemChanges      MeetingMinuteActionItem[]     @relation("MeetingActionItemStatusChanger")
  meetingActionItemLogs         MeetingMinuteActionItemLog[]  @relation("MeetingActionItemLogActor")
  importBatches                 ImportBatch[]                 @relation("ImportBatchUploader")
  utLockedProjects              UtProjectSetting[]            @relation("UtProjectLocker")
  utCreatedPrograms             UtProgram[]                   @relation("UtProgramCreator")
  utPlCases                     UtCase[]                      @relation("UtCasePl")
  utApprovedCases               UtCase[]                      @relation("UtCaseApprover")
  utExecutorCases               UtCase[]                      @relation("UtCaseExecutor")
  utQcCases                     UtCase[]                      @relation("UtCaseQc")
  utCreatedCases                UtCase[]                      @relation("UtCaseCreator")
  utWorkerCases                 UtCase[]                      @relation("UtCaseWorker")
  defectsCreated                Defect[]                      @relation("DefectCreator")
  defectsAssigned               Defect[]                      @relation("DefectAssignee")
  utExecutions                  UtExecution[]                 @relation("UtExecutionExecutor")
  utApprovals                   UtApproval[]                  @relation("UtApprovalApprover")
  utUploadedEvidences           UtEvidence[]                  @relation("UtEvidenceUploader")
  utEvidenceViews               UtEvidenceView[]              @relation("UtEvidenceViewer")
  utAssignedDefects             UtDefect[]                    @relation("UtDefectAssignee")
  utFixedDefects                UtDefect[]                    @relation("UtDefectFixer")
  utVerifiedDefects             UtDefect[]                    @relation("UtDefectVerifier")
  utCreatedDefects              UtDefect[]                    @relation("UtDefectCreator")
  utDefectActions               UtDefectAction[]              @relation("UtDefectActionActor")
  utDeclaredMilestones          UtWbsMilestone[]              @relation("UtMilestoneDeclarer")
  utConfirmedMilestones         UtWbsMilestone[]              @relation("UtMilestoneConfirmer")
  utRecordedMilestones          UtWbsMilestone[]              @relation("UtMilestoneRecorder")
  utWbsMigrations               UtWbsMigration[]              @relation("UtMigrationMigrator")

  @@map("users")
}

enum PasswordResetRequestStatus {
  PENDING
  RESOLVED
}

model PasswordResetRequest {
  id           String                     @id @default(uuid())
  userId       String
  note         String?
  status       PasswordResetRequestStatus @default(PENDING)
  createdAt    DateTime                   @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  user       User  @relation("PasswordResetRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("PasswordResetRequestResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@map("password_reset_requests")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      UserRole @default(MEMBER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ---------------------------------------------------------------------------
// 프로젝트
// ---------------------------------------------------------------------------

enum OpenMethod {
  phased
  big_bang
}

enum ProjectGrade {
  A
  B
  C
}

model Project {
  id                String       @id @default(uuid())
  code              String       @unique
  name              String
  parentId          String?
  openMethod        OpenMethod   @default(phased)
  startDate         DateTime?    @db.Date
  endDate           DateTime?    @db.Date
  firstOpenDate     DateTime?    @db.Date
  secondOpenDate    DateTime?    @db.Date
  goLiveDate        DateTime?    @db.Date
  description       String       @default("")
  customerName      String       @default("")
  vendorName        String       @default("")
  customerPm        String       @default("")
  customerPmoCount  Int          @default(0)
  vendorPm          String       @default("")
  vendorPmoCount    Int          @default(0)
  projectGrade      ProjectGrade @default(B)
  timezone          String       @default("Asia/Seoul")
  staleBusinessDays Int          @default(3)
  sortOrder         Int          @default(0) // 노출 우선순위 — 작을수록 위. 같으면 이름순(프로젝트 관리 목록·프로젝트 전환·WBS2 대상 프로젝트 선택)
  numberingBase     Int?         @unique // 번호 시작점(10만 단위) — 전역 유일 표시 ID 7종의 프로젝트별 순번 구간. 생성 시 자동 발번, 화면 수정 불가(2026-09-30)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  parent                    Project?                    @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                  Project[]                   @relation("ProjectHierarchy")
  members                   ProjectMember[]
  groups                    Groups[]
  commonCodeGroups          CommonCodeGroup[]
  commonCodes               CommonCode[]
  issues                    Issue[]
  weeks                     Week[]
  calendarEvents            CalendarEvent[]
  auditLogs                 AuditLog[]
  issueSequence             IssueSequence?
  meetingRooms              MeetingRoom[]
  meetingReservations       MeetingReservation[]
  recurringMeetings         RecurringMeetingReservation[]
  requirements              Requirement[]
  requirementSequence       RequirementSequence?
  requirementChanges        RequirementChange[]
  requirementChangeSequence RequirementChangeSequence?
  menuPreferences           MenuPreference[]
  defects                   Defect[]
  defectStatusClasses       DefectStatusClass[]
  defectSeveritySettings    DefectSeveritySetting[]
  defectTargetSites         DefectTargetSite[]
  defectScreens             DefectScreen[]
  wbsItemTestStages         WbsItemTestStage[]
  portfolioPanelPreferences PortfolioPanelPreference[]
  announcements             Announcement[]
  managementTasks           ManagementTask[]
  managementTaskSequence    ManagementTaskSequence?
  managementTaskLinks       ManagementTaskLink[]
  actionItems               ActionItem[]
  pmoDailySnapshots         PmoDailySnapshot[]
  pmoDelayedTaskSequences   PmoDelayedTaskSequence?
  workLogs                  WorkLog[]
  workLogSequence           WorkLogSequence?
  wbsItems                  WbsItem[]
  wbsItemSequence           WbsItemSequence?
  wbsDelayedTasks           WbsDelayedTask[]
  holidays                  Holiday[]
  meetingMinutes            MeetingMinute[]
  meetingMinuteSequence     MeetingMinuteSequence?
  utSetting                 UtProjectSetting?
  utPrograms                UtProgram[]
  utCases                   UtCase[]

  @@index([parentId])
  importBatches ImportBatch[]
  @@map("projects")
}

model MenuPreference {
  projectId       String
  menuKey         String
  label           String
  visibleAdmin    Boolean @default(true)
  visibleOperator Boolean @default(true)
  visibleMember   Boolean @default(true)
  sortOrder       Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, menuKey])
  @@map("menu_preferences")
}

model PortfolioPanelPreference {
  projectId String
  panelKey  String
  visible   Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, panelKey])
  @@map("portfolio_panel_preferences")
}

// ---------------------------------------------------------------------------
// 그룹 (조직그룹 + 업무그룹 통합 — 기존 Track 흡수)
// ---------------------------------------------------------------------------

enum GroupType {
  WORK_MODULE
  COMPANY
}

model Groups {
  id        String    @id @default(uuid())
  projectId String
  groupType GroupType
  code      String
  label     String
  color     String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  leaderId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leader          User?            @relation("WorkGroupLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  userMap         UserGroupMap[]
  weeklyReports   WeeklyReport[]
  weeklyProgress  WeeklyProgress[]
  staffChanges    StaffChange[]
  calendarEvents  CalendarEvent[]
  eventTags       EventGroupTag[]
  managementTasks ManagementTask[]
  pmoDelayedTasks PmoDelayedTask[]
  workLogs        WorkLog[]
  actionItems     ActionItem[]
  utPrograms       UtProgram[]  @relation("UtProgramGroup")
  utCases          UtCase[]     @relation("UtCaseGroup")
  utCauseDefects   UtDefect[]   @relation("UtDefectCauseGroup")
  utVendorDefects  UtDefect[]   @relation("UtDefectVendorGroup")
  defects          Defect[]     @relation("DefectGroup")

  @@unique([projectId, groupType, code])
  @@index([leaderId])
  @@map("groups")
}

model UserGroupMap {
  userId  String
  groupId String

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Groups @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("user_group_map")
}

// ---------------------------------------------------------------------------
// 업무일지
// ---------------------------------------------------------------------------

enum WorkLogStatus {
  IN_PROGRESS
  COMPLETED
  DELETED
}

model WorkLog {
  id                       String        @id @default(uuid())
  displayId                String        @unique
  projectId                String
  workDate                 DateTime      @db.Date
  groupId                  String
  assigneeId               String
  wbsNumber                String        @default("")
  status                   WorkLogStatus @default(IN_PROGRESS)
  workContent              String
  deliverableName          String?
  deliverableExtensionCodeId String?
  referenceContent         String        @default("")
  notes                    String        @default("")
  version                  Int           @default(1)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  project                  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group                    Groups      @relation(fields: [groupId], references: [id])
  assignee                 User        @relation("WorkLogAssignee", fields: [assigneeId], references: [id])
  deliverableExtensionCode CommonCode? @relation("WorkLogDeliverableExtension", fields: [deliverableExtensionCodeId], references: [id])

  @@index([projectId, workDate])
  @@index([projectId, assigneeId, workDate])
  @@index([groupId])
  @@index([deliverableExtensionCodeId])
  @@map("work_logs")
}

model WorkLogSequence {
  projectId String @id
  value     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_log_sequences")
}

// ---------------------------------------------------------------------------
// 공통코드 (유형 / 에스컬레이션 — 그룹 개념과 무관, 기존 체계 유지)
// ---------------------------------------------------------------------------

model CommonCodeGroup {
  id          String   @id @default(uuid())
  projectId   String?
  code        String
  label       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codes   CommonCode[]

  @@unique([projectId, code])
  @@map("common_code_groups")
}

model CommonCode {
  id        String   @id @default(uuid())
  projectId String?
  groupId   String
  groupCode String
  code      String
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  minScore  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project                   Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group                     CommonCodeGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  issuesByCategory          Issue[]                   @relation("IssueCategory")
  issuesByReportLine        IssueReportLine[]         @relation("IssueReportLine")
  issueProgressByCategory   IssueProgress[]           @relation("IssueProgressCategory")
  issueProgressByReportLine IssueProgressReportLine[] @relation("IssueProgressReportLine")
  requirementsByDivision    Requirement[]             @relation("RequirementDivision")
  requirementsByCategory    Requirement[]             @relation("RequirementCategory")
  wbsItems                  WbsItem[]
  wbsAssignments            WbsAssignment[]
  actionItemsByCategory     ActionItem[]              @relation("ActionItemCategory")
  workLogsByDeliverableExtension WorkLog[]            @relation("WorkLogDeliverableExtension")
  utExecutionEnvs        UtExecution[] @relation("UtExecutionEnv")
  utApprovalRejectReasons UtApproval[] @relation("UtApprovalRejectReason")
  utDefectTypes          UtDefect[]    @relation("UtDefectType")
  utCaseTypes            UtCase[]      @relation("UtCaseTypeCode")
  defectTestStages       Defect[]      @relation("DefectTestStage")
  defectSeverities       Defect[]      @relation("DefectSeverity")
  defectPriorities       Defect[]      @relation("DefectPriority")
  defectStatuses         Defect[]      @relation("DefectStatus")
  defectIdentifications  Defect[]      @relation("DefectIdentification")
  defectStatusClasses    DefectStatusClass[]    @relation("DefectStatusClassCode")
  defectSeveritySettings DefectSeveritySetting[] @relation("DefectSeveritySettingCode")
  wbsItemTestStages      WbsItemTestStage[]     @relation("WbsItemTestStageCode")

  @@unique([groupId, code])
  @@map("common_codes")
}

// ---------------------------------------------------------------------------
// 이슈관리
// ---------------------------------------------------------------------------

enum ProbabilityLevel {
  low
  medium
  high
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model Issue {
  id                 String           @id @default(uuid())
  displayId          String           @unique
  seq                Int
  projectId          String
  categoryCodeId     String
  title              String
  description        String           @default("")
  importance         ProbabilityLevel
  priority           ProbabilityLevel
  status             IssueStatus      @default(OPEN)
  occurredAt         DateTime         @db.Date
  dueAt              DateTime?        @db.Date
  ownerUserId        String?
  ownerName          String?
  responseContent    String           @default("")
  escalated          Boolean          @default(false)
  remark             String           @default("")
  createdBy          String
  lastModifiedBy     String?
  lastModifiedByName String?
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  closedAt           DateTime?
  archivedAt         DateTime?

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category        CommonCode        @relation("IssueCategory", fields: [categoryCodeId], references: [id])
  creator         User              @relation("IssueCreator", fields: [createdBy], references: [id])
  owner           User?             @relation("IssueOwner", fields: [ownerUserId], references: [id])
  lastModifier    User?             @relation("IssueLastModifier", fields: [lastModifiedBy], references: [id])
  reportLines     IssueReportLine[]
  progressEntries IssueProgress[]

  @@index([projectId, status])
  @@index([projectId, archivedAt])
  @@map("issues")
}

// 이슈진행정보(DETAIL) — 최초 등록(이슈관리정보)과 동일한 전체 필드를 갖춘 시점별 스냅샷.
// 별도의 가벼운 로그가 아니라 등록 당시와 같은 정보 수준으로 관리되며, 가장 최근 스냅샷의
// 내용이 그대로 이슈관리정보(MASTER)에 반영된다(자동 동기화) — 진행 이력을 남기는 것이
// 곧 이슈 정보를 갱신하는 유일한 방법이다.
model IssueProgress {
  id              String           @id @default(uuid())
  issueId         String
  entryDate       DateTime         @db.Date
  status          IssueStatus
  categoryCodeId  String
  title           String
  description     String           @default("")
  importance      ProbabilityLevel
  priority        ProbabilityLevel
  dueAt           DateTime?        @db.Date
  ownerUserId     String?
  ownerName       String?
  responseContent String           @default("")
  escalated       Boolean          @default(false)
  remark          String           @default("")
  actorId         String?
  actorName       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  issue       Issue                     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  category    CommonCode                @relation("IssueProgressCategory", fields: [categoryCodeId], references: [id])
  owner       User?                     @relation("IssueProgressOwner", fields: [ownerUserId], references: [id])
  actor       User?                     @relation("IssueProgressActor", fields: [actorId], references: [id])
  reportLines IssueProgressReportLine[]

  @@index([issueId, entryDate])
  @@map("issue_progress_entries")
}

model IssueProgressReportLine {
  progressId       String
  reportLineCodeId String

  progress       IssueProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  reportLineCode CommonCode    @relation("IssueProgressReportLine", fields: [reportLineCodeId], references: [id])

  @@id([progressId, reportLineCodeId])
  @@index([reportLineCodeId])
  @@map("issue_progress_report_lines")
}

model IssueReportLine {
  issueId          String
  reportLineCodeId String

  issue          Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  reportLineCode CommonCode @relation("IssueReportLine", fields: [reportLineCodeId], references: [id])

  @@id([issueId, reportLineCodeId])
  @@index([reportLineCodeId])
  @@map("issue_report_lines")
}

model IssueSequence {
  projectId String @id
  value     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("issue_sequences")
}

// ---------------------------------------------------------------------------
// 요구사항관리 (요구사항정의서 + 요구사항변경관리)
// ---------------------------------------------------------------------------

enum RequirementAcceptance {
  pending
  accepted
  partially_accepted
  rejected
  deferred
}

enum RequirementEventType {
  created
  edited
  archived
  change_requested
  change_approved
  change_rejected
}

enum RequirementChangeStatus {
  pending
  approved
  rejected
}

model Requirement {
  id                     String                @id @default(uuid())
  displayId              String                @unique
  requirementId          String?
  projectId              String
  title                  String
  content                String                @default("")
  ownerUserId            String?
  basis                  String                @default("")
  precondition           String                @default("")
  resolution             String                @default("")
  businessMajorCategory  String                @default("")
  businessMiddleCategory String                @default("")
  businessMinorCategory  String                @default("")
  registrationDate       DateTime?
  addedAfterConfirmation Boolean?
  notes                  String                @default("")
  finalCheckNote         String                @default("")
  inspectionCriteria     String                @default("")
  acceptanceStatus       RequirementAcceptance @default(pending)
  requestDepartment      String                @default("")
  divisionCodeId         String?
  categoryCodeId         String?
  priority               ProbabilityLevel?
  importance             ProbabilityLevel?
  createdBy              String
  version                Int                   @default(1)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  archivedAt             DateTime?

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner    User?               @relation("RequirementOwner", fields: [ownerUserId], references: [id])
  creator  User                @relation("RequirementCreator", fields: [createdBy], references: [id])
  division CommonCode?         @relation("RequirementDivision", fields: [divisionCodeId], references: [id])
  category CommonCode?         @relation("RequirementCategory", fields: [categoryCodeId], references: [id])
  events   RequirementEvent[]
  changes  RequirementChange[]
  utCases  UtCase[]

  @@unique([projectId, requirementId])
  @@index([projectId, archivedAt])
  @@index([projectId, acceptanceStatus])
  @@map("requirements")
}

model RequirementSequence {
  projectId String @id
  value     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("requirement_sequences")
}

model RequirementEvent {
  id            String               @id @default(uuid())
  requirementId String
  eventType     RequirementEventType
  actorId       String?
  actorName     String?
  body          String?
  beforeData    Json?
  afterData     Json?
  createdAt     DateTime             @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id])

  @@index([requirementId, createdAt])
  @@map("requirement_events")
}

model RequirementChangeSequence {
  projectId String @id
  value     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("requirement_change_sequences")
}

model RequirementChange {
  id                   String                  @id @default(uuid())
  displayId            String                  @unique
  title                String
  projectId            String
  requirementId        String
  changeReason         String
  proposedTitle        String?
  proposedContent      String?
  proposedBasis        String?
  proposedPrecondition String?
  proposedResolution   String?
  proposedAcceptance   RequirementAcceptance?
  status               RequirementChangeStatus @default(pending)
  requestedBy          String
  requestedAt          DateTime                @default(now())
  decidedBy            String?
  decidedAt            DateTime?
  decisionNote         String?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  requester   User        @relation("RequirementChangeRequester", fields: [requestedBy], references: [id])
  decider     User?       @relation("RequirementChangeDecider", fields: [decidedBy], references: [id])

  @@index([projectId, status])
  @@index([requirementId, requestedAt])
  @@map("requirement_changes")
}

// ---------------------------------------------------------------------------
// 프로젝트통합모니터링 (관리업무항목)
// ---------------------------------------------------------------------------

enum ManagementTaskBand {
  RED
  YELLOW
  GREEN
}

enum ManagementTaskStatus {
  IDENTIFIED
  IN_PROGRESS
  ISSUE_TRANSFERRED
  RISK_TRANSFERRED
  CLOSED
}

model ManagementTask {
  id               String               @id @default(uuid())
  displayId        String               @unique
  projectId        String
  groupId          String // WORK_MODULE Groups row (assertWorkModuleGroup으로 검증)
  name             String
  registrationDate DateTime             @db.Date
  status           ManagementTaskStatus @default(IDENTIFIED)
  purpose          String               @default("")
  impactAnalysis   String               @default("")
  totalScore       Int                  @default(0)
  band             ManagementTaskBand   @default(RED)
  createdBy        String
  version          Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  archivedAt       DateTime?

  project          Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group            Groups                     @relation(fields: [groupId], references: [id])
  creator          User                       @relation("ManagementTaskCreator", fields: [createdBy], references: [id])
  predecessorLinks ManagementTaskLink[]       @relation("TaskSuccessor")
  successorLinks   ManagementTaskLink[]       @relation("TaskPredecessor")
  assignees        ManagementTaskAssignee[]
  detailItems      ManagementTaskDetailItem[]

  @@index([projectId, archivedAt])
  @@index([projectId, groupId])
  @@index([projectId, band])
  @@map("management_tasks")
}

model ManagementTaskAssignee {
  taskId String
  userId String

  task ManagementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("management_task_assignees")
}

model ManagementTaskSequence {
  projectId String @id
  value     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("management_task_sequences")
}

model ManagementTaskLink {
  id            String   @id @default(uuid())
  projectId     String
  predecessorId String
  successorId   String
  createdBy     String
  createdAt     DateTime @default(now())

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor ManagementTask @relation("TaskPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ManagementTask @relation("TaskSuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  creator     User           @relation("ManagementTaskLinkCreator", fields: [createdBy], references: [id])

  @@unique([predecessorId, successorId])
  @@index([projectId, predecessorId])
  @@index([projectId, successorId])
  @@map("management_task_links")
}

enum ActionItemStatus {
  IDENTIFIED
  IN_PROGRESS
  DELAYED
  ISSUE
  CLOSED
}

model ManagementTaskDetailItem {
  id        String             @id @default(uuid())
  taskId    String
  axisKey   String // "prep" | "owner" | "progress" | "issue" | "close" (ManagementTaskAxisKey)
  axisScore Int                @default(0) // 0/10/20 환산 점수 — ManagementTask.totalScore 합산에 쓰임
  band      ManagementTaskBand @default(RED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  task        ManagementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actionItems ActionItem[]

  @@unique([taskId, axisKey])
  @@index([taskId])
  @@map("management_task_detail_items")
}

model ActionItem {
  id             String           @id @default(uuid())
  detailItemId   String
  projectId      String // PM/PMO 전체 액션아이템목록조회용 비정규화
  sequenceNo     Int // detailItem 범위 내 순번
  categoryCodeId String? // CommonCode(action_item_category)
  name           String
  priority       Priority
  importance     Priority
  groupId        String // Groups(WORK_MODULE), assertWorkModuleGroup으로 검증
  assigneeId     String
  createdBy      String
  dueDate        DateTime?        @db.Date
  status         ActionItemStatus @default(IDENTIFIED)
  wbsItemId      String?
  note           String           @default("")
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  archivedAt     DateTime?

  detailItem   ManagementTaskDetailItem @relation(fields: [detailItemId], references: [id], onDelete: Cascade)
  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group        Groups                   @relation(fields: [groupId], references: [id])
  assignee     User                     @relation("ActionItemAssignee", fields: [assigneeId], references: [id])
  creator      User                     @relation("ActionItemCreator", fields: [createdBy], references: [id])
  wbsItem      WbsItem?                 @relation(fields: [wbsItemId], references: [id])
  categoryCode CommonCode?              @relation("ActionItemCategory", fields: [categoryCodeId], references: [id])

  @@unique([detailItemId, sequenceNo])
  @@index([projectId, archivedAt])
  @@index([projectId, status])
  @@index([groupId])
  @@index([assigneeId])
  @@map("action_items")
}

// ---------------------------------------------------------------------------
// PMO Daily
// ---------------------------------------------------------------------------

enum PmoDelayedTaskStatus {
  IDENTIFIED
  ACTION_IN_PROGRESS
  NORMALIZED
  CLOSED
}

model PmoDailySnapshot {
  id                 String   @id @default(uuid())
  projectId          String
  reportDate         DateTime @db.Date
  plannedTaskCount   Int      @default(0)
  actualTaskCount    Int      @default(0)
  totalTaskCount     Int      @default(0)
  completedTaskCount Int      @default(0)
  createdBy          String
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator      User             @relation("PmoDailySnapshotCreator", fields: [createdBy], references: [id])
  delayedTasks PmoDelayedTask[]

  @@unique([projectId, reportDate])
  @@index([projectId, reportDate])
  @@map("pmo_daily_snapshots")
}

model PmoDelayedTask {
  id              String               @id @default(uuid())
  displayId       String               @unique
  snapshotId      String
  groupId         String
  description     String
  plannedProgress Int
  actualProgress  Int
  plannedEndDate  DateTime?            @db.Date
  delayReason     String               @default("")
  responsePlan    String               @default("")
  status          PmoDelayedTaskStatus @default(IDENTIFIED)
  createdBy       String
  version         Int                  @default(1)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
