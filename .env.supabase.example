# Supabase Dashboard > Connect > Transaction pooler의 연결 문자열을 사용합니다.
# 비밀번호의 특수문자는 URL 인코딩해야 합니다.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_SSL=require
DATABASE_POOL_MAX=3
DATABASE_CONNECTION_TIMEOUT_MS=10000

# 초기 스키마에 포함된 개발용 PMO 사용자와 프로젝트입니다.
LOCAL_USER_ID=10000000-0000-4000-8000-000000000001
DEFAULT_PROJECT_ID=20000000-0000-4000-8000-000000000001

# 선택 사항: Supabase CA 인증서를 사용할 때 설정합니다.
# DATABASE_SSL=verify-full
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
